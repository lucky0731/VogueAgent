# Copy this file to `.env` and fill in the values.

# --- The store's product catalog (read-only) — same value as the store's MONGO_URI ---
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# --- LLM (required unless PORTKEY_API_KEY is set) — https://console.groq.com/keys ---
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY

# --- LLM gateway (optional — https://portkey.ai) ---
# With a real key here, Groq calls go through Portkey. PORTKEY_GROQ_PROVIDER must match
# the provider slug in your Portkey dashboard (with or without the leading @).
PORTKEY_API_KEY=REPLACE_WITH_YOUR_PORTKEY_KEY
PORTKEY_GROQ_PROVIDER=groq

# --- Server (optional) ---
# PORT=8001
# Where the store runs — product cards in the chat open its product pages.
# STORE_URL=http://localhost:8000

# --- Observability (optional) ---
# LOGFIRE_TOKEN=

# Copy this file to `.env` and fill in the values.

# --- Database (required) ---
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# --- Login tokens (required in production) ---
# Any long random string. Locally, if empty, one is generated in .secret_key.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Server (optional) ---
# HOST=127.0.0.1        # use 0.0.0.0 when deploying (Render, Docker)
# PORT=8000
# OPEN_BROWSER=true

# --- Demo data (optional, default true) ---
# When the products collection is empty, import demo_data/ on startup.
# SEED_DEMO_DATA=false

# --- Google Sign-In (optional, from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
